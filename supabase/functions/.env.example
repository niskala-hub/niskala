# Secrets untuk Supabase Edge Functions
# File ini hanya untuk referensi lokal — jangan commit ke git!
# Set secrets di Supabase Dashboard: Project Settings > Edge Functions > Secrets
# atau gunakan CLI: npx supabase secrets set KEY=value --project-ref <project_id>

# URL aplikasi (digunakan sebagai redirect target di email)
APP_URL=http://localhost:8080

# Nama aplikasi yang tampil di email
APP_NAME=NISKALA

# Resend API Key (daftar di https://resend.com — free tier: 3000 email/bulan)
# Wajib diisi agar email undangan dan reset password terkirim reliabel
RESEND_API_KEY=re_GANTI_DENGAN_API_KEY_RESEND_KAMU

# Email pengirim (harus terverifikasi di Resend atau domain kamu)
# Jika pakai domain sendiri: noreply@domainmu.com
# Jika belum punya domain, pakai: onboarding@resend.dev (hanya untuk testing)
EMAIL_FROM=onboarding@resend.dev
